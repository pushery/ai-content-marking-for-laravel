{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "pushery/ai-content-marking-for-laravel",
  "description": "Marks content made with generative AI in Laravel: machine-readable markers in the text your app delivers and in the images it stores, kept through every media library conversion, and a separate notice for readers that you place yourself.",
  "keywords": [
    "laravel",
    "php",
    "ai",
    "ai-act",
    "ai-generated",
    "content-marking",
    "transparency"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Pushery"
    }
  ],
  "type": "library",
  "homepage": "https://github.com/pushery/ai-content-marking-for-laravel",
  "support": {
    "issues": "https://github.com/pushery/ai-content-marking-for-laravel/issues",
    "source": "https://github.com/pushery/ai-content-marking-for-laravel",
    "docs": "https://docs.pushery.com/ai-content-marking-for-laravel/",
    "security": "https://github.com/pushery/ai-content-marking-for-laravel/security/policy"
  },
  "require": {
    "php": "^8.4",
    "ext-imagick": "*",
    "ext-json": "*",
    "illuminate/contracts": "^13.0",
    "illuminate/database": "^13.0",
    "illuminate/support": "^13.0",
    "spatie/laravel-medialibrary": "^11.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "larastan/larastan": "^3.9.3",
    "laravel/ai": "^1.0",
    "laravel/boost": "^2.9",
    "laravel/mcp": "^1.0",
    "laravel/pao": "^1.1",
    "laravel/pint": "^1.0",
    "orchestra/testbench": "^11.0",
    "pestphp/pest": "^5.2.1",
    "pestphp/pest-plugin-agent": "^5.0",
    "pestphp/pest-plugin-browser": "^5.2",
    "pestphp/pest-plugin-evals": "^5.1",
    "pestphp/pest-plugin-laravel": "^5.0",
    "pestphp/pest-plugin-phpstan": "^5.0",
    "pestphp/pest-plugin-type-coverage": "^5.0",
    "phpstan/phpstan": "^2.3.0",
    "pushery/sqlens-for-laravel": "^0.31",
    "rector/rector": "^2.7.0",
    "spaze/phpstan-disallowed-calls": "^4.12",
    "symfony/yaml": "^7.4.17 || ^8.1.5"
  },
  "autoload": {
    "psr-4": {
      "Pushery\\AiContentMarking\\": "src/"
    }
  },
  "config": {
    "sort-packages": true,
    "process-timeout": 0,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Pushery\\AiContentMarking\\AiContentMarkingServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
